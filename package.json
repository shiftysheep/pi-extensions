{
  "name": "@shiftysheep/pi-extensions",
  "version": "2.4.1",
  "description": "Custom extensions for pi (advisor, cron-tips, permission-gate, status-line); bundles recommended installs: pi-web-access, pi-subagents (skills+prompts), @juicesharp/rpiv-ask-user-question, @juicesharp/rpiv-todo, @ff-labs/pi-fff, @upstash/context7-pi (tools+skills+prompts).",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "license": "MIT",
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/advisor-utils.test.ts test/advisor-child.test.ts test/permission-gate.test.ts test/sandbox-utils.test.ts test/sandbox-landlock.test.ts",
    "check": "biome check && tsc --noEmit && npm test",
    "commit": "cz",
    "commit:msg": "commitlint --edit",
    "precommit:install": "pre-commit install && pre-commit install -t commit-msg"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@ff-labs/pi-fff": "^0.10.6",
    "@juicesharp/rpiv-ask-user-question": "^2.9.0",
    "@juicesharp/rpiv-todo": "^2.9.0",
    "@upstash/context7-pi": "^0.1.2",
    "pi-subagents": "^0.65.0",
    "pi-web-access": "^0.28.0"
  },
  "bundledDependencies": [
    "@ff-labs/pi-fff",
    "@juicesharp/rpiv-ask-user-question",
    "@juicesharp/rpiv-todo",
    "@upstash/context7-pi",
    "pi-subagents",
    "pi-web-access"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/advisor.ts",
      "./extensions/cron.ts",
      "./extensions/permission-gate.ts",
      "./extensions/status-line.ts",
      "node_modules/@ff-labs/pi-fff/src/index.ts",
      "node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "node_modules/@juicesharp/rpiv-todo/index.ts",
      "node_modules/@upstash/context7-pi/extensions/context7.ts",
      "node_modules/pi-subagents/index.ts",
      "node_modules/pi-web-access/index.ts"
    ],
    "skills": [
      "node_modules/pi-subagents/skills",
      "node_modules/@upstash/context7-pi/skills"
    ],
    "prompts": [
      "node_modules/pi-subagents/prompts",
      "node_modules/@upstash/context7-pi/prompts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "bundleDependencies": [
    "@ff-labs/pi-fff",
    "@juicesharp/rpiv-ask-user-question",
    "@juicesharp/rpiv-todo",
    "@upstash/context7-pi",
    "pi-subagents",
    "pi-web-access"
  ]
}
